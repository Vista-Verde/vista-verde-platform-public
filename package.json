{
  "name": "vista-verde-slot-spike",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "26.0.0"
  },
  "scripts": {
    "test": "node --test tests/slots.test.ts",
    "demo": "node examples/slots/demo.ts",
    "test:producer": "npm run build && node tools/test-foundation.ts producer",
    "demo:producer": "node apps/producer-demo/serve.ts",
    "demo:requester": "npm run build && node apps/producer-demo/preview.ts",
    "test:contracts": "node --test tests/foundation/contracts.test.ts tests/foundation/market-contracts.test.ts",
    "test:foundation": "npm run build && node tools/test-foundation.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node tools/copy-schema.ts && node tools/build-web.ts",
    "lint": "eslint packages apps tools tests/foundation .storybook",
    "test:web": "npm run build && node tools/test-foundation.ts web",
    "test:web:strict": "VV_REACT_MODE=development npm run test:web",
    "test:react": "node tools/test-react.ts",
    "test:print:model": "node --test tests/foundation/print-model.test.ts tests/foundation/route-demo-model.test.ts",
    "test:print": "npm run build && node tools/test-foundation.ts print",
    "demo:print": "npm run build && VV_PRINT_TRACE=1 node tools/test-foundation.ts print",
    "test:economics": "node --test tests/foundation/payment-economics.test.ts",
    "demo:web": "npm run build && node tools/test-foundation.ts demo",
    "local:build": "node tools/local-deployment.ts build",
    "local:up": "node tools/local-deployment.ts up",
    "local:open": "node tools/local-deployment.ts open",
    "local:stop": "node tools/local-deployment.ts stop",
    "local:restart": "node tools/local-deployment.ts restart",
    "local:status": "node tools/local-deployment.ts status",
    "local:backup": "node tools/local-deployment.ts backup",
    "local:restore-test": "node tools/local-deployment.ts restore-test",
    "test:local": "npm run build && node --test --test-concurrency=1 tests/foundation/local.test.ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 node --import ./.storybook/local-settings.ts ./node_modules/storybook/dist/bin/dispatcher.js dev -p 6006 --host 127.0.0.1 --no-open --no-version-updates --disable-telemetry",
    "build-storybook": "VV_STORYBOOK_STATIC_BUILD=1 STORYBOOK_DISABLE_TELEMETRY=1 node --import ./.storybook/local-settings.ts ./node_modules/storybook/dist/bin/dispatcher.js build --disable-telemetry",
    "export:agent-architecture": "node tools/export-agent-architecture.ts",
    "test:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 node --import ./.storybook/local-settings.ts ./node_modules/vitest/vitest.mjs run --config .storybook/vitest.config.ts",
    "build:storybook:production": "npm run build-storybook && node tools/copy-storybook.ts",
    "test:storybook:host": "npm run build && npm run build:storybook:production && node tools/test-foundation.ts storybook"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.58.2",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
